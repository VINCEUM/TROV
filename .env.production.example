# TROV production environment template.
# Copy to .env on the server, fill in the real values, then run:
#   php artisan key:generate
# Never commit the real .env.

APP_NAME=TROV
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://trov.example.com
APP_TIMEZONE=Asia/Manila

# --- Database (MySQL 8 required: the schema uses utf8mb4_0900 collation) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=trov
DB_USERNAME=trov_app
DB_PASSWORD=change-me-to-a-strong-password

# --- Sessions: database-backed, cookie only sent over HTTPS ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- File storage: screenshots & devotionals live on the private local disk ---
FILESYSTEM_DISK=local

# --- Misc ---
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stack
LOG_LEVEL=warning
